# ── Mercado Livre ──────────────────────────────────────────────
# Access token (also called "get token"). Optional if MELI_APP_ID +
# MELI_APP_SECRET are set. Tokens last ~6h.
MELI_ACCESS_TOKEN=

# Optional: provide the OAuth app details to obtain tokens automatically.
# With only MELI_APP_ID + MELI_APP_SECRET the client uses the client_credentials
# grant (new token on every run). Add a refresh token for user-scoped access.
# Create an app at https://developers.mercadolivre.com.br and request the
# read/write orders scope (`offline_access` for refresh token).
# MELI_APP_ID=123456789
# MELI_APP_SECRET=your_secret
# MELI_REFRESH_TOKEN=your_refresh_token

# How many days back to look for orders
ORDERS_DAYS=7

# Comma-separated order statuses to include. Common: paid, confirmed.
# Full list: https://developers.mercadolibre.com.br/en_us/sales-order
ORDER_STATUSES=paid

# Where invoice PDFs are saved
OUTPUT_DIR=./invoices

# SQLite database that remembers which labels were already emailed.
# Local file (used when DB_URL is empty):
DB_PATH=./data/labels.db
# Remote Turso/libSQL database (used by GitHub Actions):
# DB_URL=libsql://your-db-your-org.turso.io
# DB_AUTH_TOKEN=your_turso_token
# How many paid orders to scan when looking for pending shipments
LABELS_MAX_ORDERS=300

# Where invoices are delivered: whatsapp, email or both
DELIVERY_MODE=email

# ── Email (SMTP) ───────────────────────────────────────────────
# Any SMTP provider works. Free options:
#   Gmail:  smtp.gmail.com:587       (App Password, requires 2FA)
#   Brevo:  smtp-relay.brevo.com:587 (free 300 emails/day)
#   Resend: smtp.resend.com:587      (user "resend", password = API key)
# Leave SMTP_HOST empty if you only use WhatsApp (adjust DELIVERY_MODE).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465), false for STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address shown to recipients (defaults to SMTP_USER)
EMAIL_FROM=
# Comma-separated recipients for invoices/other emails
EMAIL_TO=
# Comma-separated recipients for shipping labels (required for npm run labels)
LABELS_EMAIL_TO=

# ── WhatsApp ───────────────────────────────────────────────────
# Mode: "web" (default, whatsapp-web.js) or "click-to-chat"
WHATSAPP_MODE=web

# Group to send to. Set ONE of these:
#   Group id example: 120363123456789012@g.us
WHATSAPP_GROUP_ID=
#   Or the group name to look up automatically:
WHATSAPP_GROUP_NAME=Minhas Vendas

# Where the whatsapp-web session is stored (QR only needed on first run)
WHATSAPP_SESSION_DIR=./.wwebjs_auth

# Only used when WHATSAPP_MODE=click-to-chat: comma-separated phone numbers
# (international, no +/spaces) to print fallback links for.
FALLBACK_NUMBERS=

# Timezone used on invoices (IANA name)
TIMEZONE=America/Sao_Paulo
