# ── Mercado Livre ──────────────────────────────────────────────
# Access token (also called "get token"). Required. It lasts 6h.
MELI_ACCESS_TOKEN=your_access_token_here

# Optional: to auto-refresh the token, provide the OAuth app details + refresh token.
# Create an app at https://developers.mercadolivre.com.br and request the
# read/write orders scope (`offline_access` for refresh token).
# MELI_APP_ID=123456789
# MELI_APP_SECRET=your_secret
# MELI_REFRESH_TOKEN=your_refresh_token

# How many days back to look for orders
ORDERS_DAYS=7

# Comma-separated order statuses to include. Common: paid, confirmed.
# Full list: https://developers.mercadolibre.com.br/en_us/sales-order
ORDER_STATUSES=paid

# Where invoice PDFs are saved
OUTPUT_DIR=./invoices

# ── WhatsApp ───────────────────────────────────────────────────
# Mode: "web" (default, whatsapp-web.js) or "click-to-chat"
WHATSAPP_MODE=web

# Group to send to. Set ONE of these:
#   Group id example: 120363123456789012@g.us
WHATSAPP_GROUP_ID=
#   Or the group name to look up automatically:
WHATSAPP_GROUP_NAME=Minhas Vendas

# Where the whatsapp-web session is stored (QR only needed on first run)
WHATSAPP_SESSION_DIR=./.wwebjs_auth

# Only used when WHATSAPP_MODE=click-to-chat: comma-separated phone numbers
# (international, no +/spaces) to print fallback links for.
FALLBACK_NUMBERS=

# Timezone used on invoices (IANA name)
TIMEZONE=America/Sao_Paulo
